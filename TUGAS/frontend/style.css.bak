/* General Reset */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  line-height: 1.6;
  color: #333;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Wrapper untuk sticky footer */
.wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* Header */
.header {
  background-color: #d4d4d8;
  color: white;
  padding: 15px 20px;
}

.header .container {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header .logo img {
  height: 50px; /* Ukuran logo diperbaiki */
  width: auto; /* Menjaga proporsi */
}

.navbar ul {
  display: flex;
  list-style: none;
}

.navbar ul li {
  margin: 0 10px;
}

.navbar ul li a {
  text-decoration: none;
  color: #394e6a;
  padding: 5px 10px;
  border-radius: 5px;
  transition: background-color 0.3s;
}

.navbar ul li a:hover {
  background-color: #c3c5cb;
}

/* Hero Section */
.hero {
  position: relative;
  text-align: center;
  color: white;
  padding: 50px 20px;
  background: rgba(0, 0, 0, 0.5);
}

.hero-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
  z-index: -1;
  opacity: 0.8;
}

.hero h1 {
  font-size: 2.5rem;
  margin-bottom: 15px;
}

.hero p {
  font-size: 1.2rem;
  margin-bottom: 20px;
}

.hero-buttons .btn-primary,
.hero-buttons .btn-secondary {
  text-decoration: none;
  color: white;
  padding: 10px 20px;
  border-radius: 5px;
  margin: 5px;
}

.hero-buttons .btn-primary {
  background-color: #007bff;
}

.hero-buttons .btn-secondary {
  background-color: #6c757d;
}

.hero-buttons .btn-primary:hover {
  background-color: #0056b3;
}

.hero-buttons .btn-secondary:hover {
  background-color: #5a6268;
}

/* Features Section */
.features {
  background-color: #f9f9f9;
  padding: 50px 20px;
  text-align: center;
}

.features h2 {
  margin-bottom: 30px;
}

.features-grid {
  display: flex;
  justify-content: space-between;
  gap: 20px;
}

.feature-card {
  flex: 1;
  padding: 20px;
  background-color: white;
  border: 1px solid #ddd;
  border-radius: 10px;
  text-align: center;
}

.feature-card i {
  font-size: 2rem;
  color: #007bff;
  margin-bottom: 15px;
}

.feature-card h3 {
  margin-bottom: 10px;
}

/* Footer */
.footer {
  background-color: #333;
  color: white;
  text-align: center;
  padding: 20px;
}

.footer .social-links a {
  color: white;
  margin: 0 10px;
  text-decoration: none;
  font-size: 1.5rem;
}

.footer .social-links a:hover {
  color: #007bff;
}
